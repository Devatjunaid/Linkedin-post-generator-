<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.WarningIdentifier" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/cyan</item>
    </style>

    <!-- System splash (Android 12+ style on every version). It hands over to the
         animated Compose splash, which uses the same background and logo. -->
    <style name="Theme.WarningIdentifier.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.WarningIdentifier</item>
    </style>
</resources>
