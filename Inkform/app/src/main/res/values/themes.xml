<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Inkform" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- System splash (Android 12+ and the core-splashscreen backport). It hands over immediately
         to the animated Compose splash, which starts from the same colours and mark. -->
    <style name="Theme.Inkform.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Inkform</item>
    </style>
</resources>
