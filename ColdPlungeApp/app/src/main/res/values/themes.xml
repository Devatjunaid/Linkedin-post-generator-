<resources>
    <style name="Theme.Plunge" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- System splash: dark background + the static logo; the animated splash follows in Compose. -->
    <style name="Theme.Plunge.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Plunge</item>
    </style>
</resources>
