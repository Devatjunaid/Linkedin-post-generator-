<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window colours only; system bars are handled edge-to-edge in code. -->
    <style name="Theme.PetFood" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
    </style>

    <style name="Theme.PetFood.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.PetFood</item>
    </style>
</resources>
