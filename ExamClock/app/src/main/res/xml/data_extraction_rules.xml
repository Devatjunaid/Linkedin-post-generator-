<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer keep the user's exams and plan. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="exam_clock.db" />
        <include domain="database" path="exam_clock.db-wal" />
        <include domain="database" path="exam_clock.db-shm" />
        <include domain="file" path="datastore/user_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="exam_clock.db" />
        <include domain="database" path="exam_clock.db-wal" />
        <include domain="database" path="exam_clock.db-shm" />
        <include domain="file" path="datastore/user_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
