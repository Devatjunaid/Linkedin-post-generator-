<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the ring sweeps in and the tick draws itself on the system splash. -->
    <style name="Theme.ExamClock.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.ExamClock</item>
    </style>
</resources>
