    <!-- Splash & guide -->
    <string name="guide_1_title">Every exam, counted down</string>
    <string name="guide_1_body">Add your papers once and see exactly how many days, hours and minutes are left, plus how much of the syllabus you have covered.</string>
    <string name="guide_2_title">A plan that builds itself</string>
    <string name="guide_2_body">Tell us how much time you have. Exam Clock spreads your chapters over the days left, weakest topics first, with spaced revision and past papers before each exam.</string>
    <string name="guide_3_title">Focus in timed blocks</string>
    <string name="guide_3_body">Start a focus block from any planned session. Breaks are timed for you and every minute counts towards your daily goal.</string>
    <string name="guide_4_title">Know if you are on track</string>
    <string name="guide_4_body">See study time per day, your streak, readiness for each exam and an early warning when a subject falls behind.</string>
    <string name="guide_position">Page %1$d of %2$d</string>

