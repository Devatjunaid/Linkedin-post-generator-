    <!-- Privacy policy (keep in sync with PRIVACY_POLICY.md) -->
    <string name="privacy_intro">Exam Clock is built to keep your study data on your phone. This policy explains what the app stores, what the advertising partner receives, and the choices you have.</string>
    <string name="privacy_s1_title">Data stored on your device</string>
    <string name="privacy_s1_body">Your exams, topics, study plan, focus history, name (optional) and settings are stored only in the app\'s private storage on your device. We do not run servers and we never receive this data. It may be included in your own Android device backup if backup is turned on.</string>
    <string name="privacy_s2_title">Advertising</string>
    <string name="privacy_s2_body">The free version shows ads from Google AdMob. To show and measure ads, Google may collect device identifiers such as the advertising ID, IP address, approximate location derived from it, and ad interaction data. In the EEA, UK and Switzerland you are asked for consent first and can change it at any time from Settings › Ad privacy choices. Google\'s policy: https://policies.google.com/privacy</string>
    <string name="privacy_s3_title">Permissions</string>
    <string name="privacy_s3_body">Internet: to load ads. Notifications: for study reminders and the focus timer, only if you allow them. No access to contacts, camera, microphone, files or precise location is requested.</string>
    <string name="privacy_s4_title">Children</string>
    <string name="privacy_s4_body">Exam Clock is meant for students aged 13 and over. Ads are limited to content rated suitable for teens.</string>
    <string name="privacy_s5_title">Deleting your data</string>
    <string name="privacy_s5_body">Use Settings › Delete all data, or uninstall the app, to remove everything stored by Exam Clock.</string>
    <string name="privacy_s6_title">Contact</string>
    <string name="privacy_s6_body">Questions about this policy: use the developer contact email shown on the app\'s Google Play listing.</string>
</resources>
