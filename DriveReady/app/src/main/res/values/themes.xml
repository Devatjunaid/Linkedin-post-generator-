<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme. System bars are handled edge-to-edge in code via enableEdgeToEdge(). -->
    <style name="Theme.DriveReady" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface_light</item>
    </style>

    <!-- System splash (Android 12+ SplashScreen API, back-ported by core-splashscreen). -->
    <style name="Theme.DriveReady.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DriveReady</item>
    </style>
</resources>
