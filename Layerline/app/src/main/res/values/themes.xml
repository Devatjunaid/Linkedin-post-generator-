<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Layerline" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/graphite</item>
        <item name="android:colorBackground">@color/graphite</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Layerline.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/graphite</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Layerline</item>
    </style>
</resources>
