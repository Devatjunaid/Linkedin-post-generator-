<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sunarc" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/sun</item>
    </style>

    <!-- System splash: the static Sunarc mark on night blue, then the animated Compose splash takes over. -->
    <style name="Theme.Sunarc.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Sunarc</item>
    </style>
</resources>
