<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="ringGroup"
                android:pivotX="54"
                android:pivotY="54"
                android:rotation="120">
                <path
                    android:name="ring"
                    android:pathData="M80,54 A26,26 0 1,1 67,31.48"
                    android:strokeColor="#D4FF3A"
                    android:strokeLineCap="round"
                    android:strokeWidth="4"
                    android:trimPathEnd="0" />
            </group>
            <group
                android:name="boltGroup"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.3"
                android:scaleY="0.3">
                <path
                    android:name="bolt"
                    android:fillAlpha="0"
                    android:fillColor="#D4FF3A"
                    android:pathData="M58,34 L44,57 L53,57 L50,74 L65,50 L56,50 Z" />
            </group>
            <path
                android:name="plug"
                android:fillAlpha="0"
                android:fillColor="#FFFFFF"
                android:pathData="M49,78 h3 v6 h-3 Z M56,78 h3 v6 h-3 Z" />
        </vector>
    </aapt:attr>

    <target android:name="ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="650"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="ringGroup">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="900"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="rotation"
                android:valueFrom="60"
                android:valueTo="120"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="bolt">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="250"
                android:propertyName="fillAlpha"
                android:startOffset="350"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="boltGroup">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="500"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleX"
                    android:startOffset="350"
                    android:valueFrom="0.3"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="500"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleY"
                    android:startOffset="350"
                    android:valueFrom="0.3"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="plug">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:propertyName="fillAlpha"
                android:startOffset="650"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
