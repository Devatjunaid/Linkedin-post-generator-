<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DotDash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- System launch screen (Android 12+ style on every version), then the animated splash. -->
    <style name="Theme.DotDash.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DotDash</item>
    </style>
</resources>
