<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Buildbros" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bm_night_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- System splash (Android 12+ always shows one). It hands off instantly to the
         animated Compose splash, which uses the same background colour. -->
    <style name="Theme.Buildbros.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bm_night_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Buildbros</item>
    </style>
</resources>
