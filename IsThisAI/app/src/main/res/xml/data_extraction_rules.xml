<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Scan history stays on this device: never uploaded to cloud backup or transferred. -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
