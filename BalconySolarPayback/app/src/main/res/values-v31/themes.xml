<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System splash (Android 12+) hands over seamlessly to the animated in-app splash. -->
    <style name="Theme.BalconySolar" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/night_deep</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/night_deep</item>
    </style>
</resources>
