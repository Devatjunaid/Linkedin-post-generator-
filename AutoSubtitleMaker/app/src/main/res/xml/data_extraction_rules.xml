<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Videos and speech models are large; only back up the project database and settings. -->
    <cloud-backup>
        <exclude domain="file" path="projects/" />
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="fonts/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
