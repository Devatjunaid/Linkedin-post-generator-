<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Unpin" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Unpin.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Unpin</item>
    </style>
</resources>
